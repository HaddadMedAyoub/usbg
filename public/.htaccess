Options -MultiViews -Indexes
DirectoryIndex index.html

# ── Branded error pages ──
ErrorDocument 404 /404.html
ErrorDocument 500 /error.html
ErrorDocument 502 /error.html
ErrorDocument 503 /error.html
ErrorDocument 504 /error.html

# ── Don't cache HTML / dynamic pages ──
# Content is fetched from Supabase at runtime, so caching the HTML shell causes
# stale pages after every deploy (and stale social previews). Disable the
# LiteSpeed page cache and make browsers revalidate HTML. Hashed /_next assets
# keep their own long-cache headers and are unaffected.
<IfModule LiteSpeed>
  CacheDisable public /
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.(html|php)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

RewriteEngine On

# ── Article social-preview handler ──
# Route every article URL through news-share.php. The PHP decides: humans get
# the real app streamed unchanged, social bots get Open Graph tags. The gate
# lives in PHP (reliable) rather than here, and nothing redirects — so no loop.
RewriteCond %{REQUEST_URI} ^/news/article/?$ [NC]
RewriteRule ^ /news-share.php [L]

# Same social-preview handling for player and donor pages.
RewriteCond %{REQUEST_URI} ^/team/player/?$ [NC]
RewriteRule ^ /player-share.php [L]

RewriteCond %{REQUEST_URI} ^/donors/donor/?$ [NC]
RewriteRule ^ /donor-share.php [L]

RewriteRule ^_next/ - [L]

RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^(.+[^/])$ /$1/ [R=301,L]

RewriteCond %{DOCUMENT_ROOT}%{REQUEST_URI}index.html -f
RewriteRule ^ %{REQUEST_URI}index.html [L]

# Unknown URLs: let Apache return a real 404 (served as the branded /404.html
# via ErrorDocument above) instead of silently showing the homepage.
